generator client {
  provider = "prisma-client-js"
  output   = "../generated/auth-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  RISK_OFFICER
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum KycApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String
  fullName   String
  role       Role      @default(CUSTOMER)
  kycStatus  KycStatus @default(PENDING)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  kycApplications KycApplication[]
}

model KycApplication {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  nicNumber      String
  addressLine1   String
  addressLine2   String?
  city           String
  employmentStatus String
  employerName   String?
  jobTitle       String?
  monthlyIncome  String
  sourceOfFunds  String

  status         KycApplicationStatus @default(SUBMITTED)

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([userId, status])
}
